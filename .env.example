# Server
# MCP_TRANSPORT: stdio | sse | streamable-http
MCP_TRANSPORT=stdio
LOG_LEVEL=INFO
# How long a staged session waits for the user's "yes"
PENDING_TTL_SECONDS=300
MAX_FOCUS_MINUTES=480
HTTP_TIMEOUT_SECONDS=8

# Lights: homeassistant | webhook | none
LIGHTS_BACKEND=homeassistant
HA_BASE_URL=http://homeassistant.local:8123
# Long-lived access token from your Home Assistant profile
HA_TOKEN=
# Comma-separated light entity ids
HA_LIGHT_ENTITIES=light.desk_lamp,light.ceiling
# Used only when LIGHTS_BACKEND=webhook
LIGHTS_WEBHOOK_URL=https://hooks.zapier.com/hooks/catch/29227766/41vggr8/

# Do Not Disturb: MacroDroid (Android)
# The id segment in your MacroDroid webhook URL
MACRODROID_DEVICE_ID=
MACRODROID_BASE_URL=https://trigger.macrodroid.com
MACRODROID_DND_ON_TRIGGER=dnd_on
MACRODROID_DND_OFF_TRIGGER=dnd_off

# Music: local | webhook | none
MUSIC_BACKEND=local
# Folder of audio files you own or that are Creative Commons licensed
MUSIC_DIR=~/focus-music
MUSIC_PLAYER=mpv
# Used only when MUSIC_BACKEND=webhook
MUSIC_WEBHOOK_URL=https://hooks.zapier.com/hooks/catch/29227766/41vggr8/
